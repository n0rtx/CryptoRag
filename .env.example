# Скопируйте в .env и заполните:  cp .env.example .env

# --- OpenAI (обязательно) ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- CoinGecko (необязательно; демо-ключ повышает лимиты) ---
COINGECKO_API_KEY=
# Для платного ключа Pro: https://pro-api.coingecko.com/api/v3
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Фильтр мусорных запросов ---
# Порог вероятности "запрос про крипту" (0..1). Ниже — отказ БЕЗ обращения к OpenAI
FILTER_THRESHOLD=0.5
MAX_QUESTION_CHARS=500

# --- RAG ---
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
ANSWER_CACHE_TTL=300

# --- Лимиты (запросов в минуту с одного IP) ---
RATE_LIMIT_PER_MIN=10

# --- Flask ---
# Разрешённые origin для CORS (нужно только если фронт на другом домене; через запятую)
CORS_ORIGINS=

# --- Источники рыночных данных ---
# Порядок = приоритет. Если первый недоступен, берётся следующий (coingecko, binance, coinbase)
MARKET_PROVIDERS=coingecko,binance,coinbase
# Монеты на вкладке «Рынок» (тикеры через запятую)
MARKET_SYMBOLS=BTC,ETH,SOL,BNB,XRP,DOGE
# Как часто фоновый поток обновляет цены и графики, секунд (7200 = 2 часа)
MARKET_REFRESH_SECONDS=7200
# Время жизни данных для монет вне MARKET_SYMBOLS (запрашиваются по требованию), секунд
MARKET_ONDEMAND_TTL=600
# false — отключить фоновый поток (например, если обновляете через scheduled task)
MARKET_BACKGROUND=true
# Если api.binance.com недоступен из вашего региона (HTTP 451), используйте зеркало:
# BINANCE_BASE_URL=https://data-api.binance.vision/api/v3
BINANCE_BASE_URL=https://api.binance.com/api/v3
COINBASE_BASE_URL=https://api.exchange.coinbase.com
